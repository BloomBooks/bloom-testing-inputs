# Per-run screenshot outputs; only the *-reference.png baselines are tracked.
*-current.png
*-diff.png

# Bloom-regenerated book files. When tests run, Bloom rewrites/copies these into each
# book folder, so they are outputs, not fixtures. Genuine fixture inputs stay tracked:
# *.htm, meta.json, appearance.json, image*.png, customCollectionStyles.css,
# publish-settings.json, screenshots/*-reference.png.
collections/**/branding.css
collections/**/appearance.css
collections/**/defaultLangStyles.css
# origami.css is a shipping support file that Bloom copies into every book folder at
# BringBookUpToDate time, so it is an output like the three above. Leaving it untracked
# also lets tests catch unexpected changes in what Bloom copies from the distribution.
collections/**/origami.css
collections/**/langVisibility.css
collections/**/thumbnail.png
collections/**/coverImage*.jpg
collections/**/license.png
collections/**/made-with-bloom-badge*.svg
collections/**/lang-qr-code.png
collections/**/history.db
# Branding xmatter stylesheets and logos copied in for whichever branding is active.
collections/**/*-XMatter.css
collections/**/USAID_*
collections/**/Uzbekistan-*
collections/**/UEEP\[*\]*.svg
collections/**/BloomLocal.svg
collections/**/BloomWithTaglineAgainstLight.svg
collections/**/Bloom Against Light HD.png

node_modules
*.log
.DS_Store
